# Wygeneruj: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
DATABASE_URI=sqlite:///fluxis.db
UPLOAD_FOLDER=/app/storage/uploads
# Lista originów oddzielona przecinkami, np. http://localhost:5173. Puste = CORS wyłączony.
CORS_ORIGINS=
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
PORT=5000
FLASK_DEBUG=false
