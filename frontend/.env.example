# Bazowy adres API widziany z przeglądarki. Domyślnie /api (proxy nginx lub Vite).
VITE_API_URL=/api

# Adres backendu dla proxy serwera deweloperskiego Vite (tylko `npm run dev`).
# Na macOS port 5000 zajmuje AirPlay: uruchom backend z PORT=5001.
API_PROXY_TARGET=http://localhost:5001

# TYLKO DEV (`npm run dev`): `true` pomija żądanie logowania (backend zwraca na razie zawsze 401)
# i wpuszcza do aplikacji bez sesji. W buildzie produkcyjnym ignorowane.
# Ustaw lokalnie w frontend/.env.development.local (plik ignorowany przez git).
# TODO(Faza 2): usunąć po wdrożeniu backend auth.
VITE_AUTH_BYPASS=false
